@startuml UPIDS核心业务流程

|#FEFEFE|用户操作|
|#E3F2FD|前端系统|
|#BBDEFB|后端服务|
|#90CAF9|任务队列|
|#64B5F6|AI检测服务|
|#FFF3E0|数据库|

start
:上传巡检图像;
partition "前端系统" {
    :选择图像文件;
    :关联管线ID;
}
partition "后端服务" {
    :保存图像文件;
    :创建巡检记录;
}
partition "数据库" {
    :INSERT inspection_record;
}
:创建检测任务;
partition "后端服务" {
    :初始化任务状态;
}
partition "数据库" {
    :INSERT detection_task (PENDING);
}
partition "任务队列" {
    :任务入队等待;
    :定时轮询消费;
}
partition "后端服务" {
    :更新状态为RUNNING;
}
partition "数据库" {
    :UPDATE detection_task;
}
partition "AI检测服务" {
    :调用识别接口;
    :AI模型推理;
    :返回识别结果;
}
if ("检测到缺陷?") then (是)
    partition "后端服务" {
        :保存缺陷记录;
    }
    partition "数据库" {
        :INSERT defect;
    }
    if ("高风险等级?") then (是)
        partition "后端服务" {
            :生成预警记录;
        }
        partition "数据库" {
            :INSERT alert_record;
        }
    else (否)
        :跳过预警;
    endif
else (否)
    :无缺陷;
endif
partition "后端服务" {
    :更新状态为DONE;
}
partition "数据库" {
    :UPDATE detection_task;
}
stop

@enduml
